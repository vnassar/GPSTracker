@inject IJSRuntime JS
@inject HttpClient Http

@page "/"
@using Shared

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@if (message != string.Empty)
{
    <p>@message</p>
}

@if (loading)
{
    <p>Loading...</p>
}

<br />
<br />
<br />
<br />

<div class="map-container">
    <div id="map" style="height: 400px; width: 100%;"></div>
</div>


@code {
    //private IJSObjectReference? _mapInstance;

    private string message = string.Empty;
    private bool loading = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JS.InvokeVoidAsync("initMap", "map");
        
    }


    private async Task RefreshLatestPosition()
    {
        var position = await Http.GetFromJsonAsync<GpsPosition>("/api/gpsposition");
        if (position == null) return;

        await JS.InvokeVoidAsync("updateMarker", position.Latitude, position.Longitude);
    }
}